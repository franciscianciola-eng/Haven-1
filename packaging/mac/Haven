#!/bin/bash
# Haven for macOS: what runs when Haven.app is opened.
#
# The first time, it sets itself up (that needs the internet and takes a few minutes), showing its
# progress on a page in the browser. After that it wakes Haven up, and Haven's window opens in the
# browser. Haven's life then goes on in the background until you press Rest in its window.
# Everything it installs goes in ~/.haven-app: Python, Haven's code, and what Haven runs on
# (it uses uv, https://docs.astral.sh/uv/). Haven's life itself is kept in ~/.haven.

APP="$HOME/.haven-app"
SOURCE="$(cd "$(dirname "$0")/../Resources/haven" && pwd)"
PAGE="$APP/setup.html"
LOG="$APP/setup.log"
export PATH="$APP/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PYTORCH_ENABLE_MPS_FALLBACK=1  # whatever the Mac's graphics chip can't do runs on its processor

ARGS=()  # options for `haven app` (Finder sometimes adds a -psn_ argument of its own)
for arg in "$@"; do
  case "$arg" in -psn_*) ;; *) ARGS+=("$arg") ;; esac
done

escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

page() {  # page STEP [done URL | failed MESSAGE]: the setup page, rewritten as setting up goes on
  local step="$1" state="$2" extra="$3"
  local title="Setting Haven up" refresh='<meta http-equiv="refresh" content="2">' script=""
  local note="This happens once and takes a few minutes. Keep this tab open: Haven's window opens here when it's ready."
  if [ "$state" = done ]; then
    title="Haven is awake"
    refresh="<meta http-equiv=\"refresh\" content=\"1; url=$extra\">"
    script="<script>setTimeout(function () { location.href = \"$extra\"; }, 600);</script>"
    note="Opening its window. If nothing happens, <a href=\"$extra\">open it here</a>."
  elif [ "$state" = failed ]; then
    title="Haven couldn't be set up"
    refresh=""
    note="$(printf '%s' "$extra" | escape) Check the internet connection, then open Haven again."
  fi
  local items="" i=1 class name
  for name in "Getting an installer" "Getting Python" "Installing what Haven runs on (about 300 MB)" "Waking Haven up"; do
    if [ "$state" = done ] || [ "$i" -lt "$step" ]; then class=done
    elif [ "$i" -gt "$step" ]; then class=todo
    elif [ "$state" = failed ]; then class=failed
    else class=now
    fi
    items="$items<li class=\"$class\">$name</li>"
    i=$((i + 1))
  done
  local log
  log="$(tail -n 14 "$LOG" 2>/dev/null | tr -d '\r' | escape)"
  cat > "$PAGE.tmp" <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
$refresh
<title>$title</title>
<style>
:root { --bg: #f6f4ef; --panel: #ffffff; --ink: #23221f; --muted: #6d6a62; --line: #e3dfd6; --accent: #b5532f; --good: #3f8f5a; --bad: #b8433a; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #161614; --panel: #201f1c; --ink: #ebe7df; --muted: #9c978c; --line: #33312c; --accent: #e0835c; --good: #6cc08a; --bad: #e0736a; }
}
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px; background: var(--bg); color: var(--ink); font: 15px/1.5 system-ui, -apple-system, sans-serif; }
main { width: min(560px, 100%); background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 22px 24px; }
h1 { margin: 0 0 6px; font-size: 20px; }
p { margin: 0 0 14px; color: var(--muted); }
a { color: var(--accent); }
ol { list-style: none; margin: 0 0 14px; padding: 0; }
li { position: relative; padding: 5px 0 5px 28px; color: var(--muted); }
li::before { content: ""; position: absolute; left: 4px; top: 11px; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--line); }
li.done { color: var(--ink); }
li.done::before { background: var(--good); border-color: var(--good); }
li.now { color: var(--ink); font-weight: 600; }
li.now::before { border-color: var(--accent); border-top-color: transparent; animation: spin 1s linear infinite; }
li.failed { color: var(--bad); font-weight: 600; }
li.failed::before { background: var(--bad); border-color: var(--bad); }
@keyframes spin { to { transform: rotate(360deg); } }
pre { margin: 0; max-height: 220px; overflow: auto; padding: 10px; font-size: 12px; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--muted); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; }
pre:empty { display: none; }
</style>
</head>
<body>
<main>
<h1>$title</h1>
<p>$note</p>
<ol>$items</ol>
<pre>$log</pre>
</main>
$script
</body>
</html>
HTML
  mv "$PAGE.tmp" "$PAGE"
}

fail() { page "$1" failed "$2"; exit 1; }

step() {  # step N COMMAND...: run a step of setting up, keeping the page up to date while it runs
  local n="$1"
  shift
  "$@" >> "$LOG" 2>&1 &
  local pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    page "$n"
    sleep 2
  done
  wait "$pid"
}

VERSION="$(grep -m1 '^version' "$SOURCE/pyproject.toml" | cut -d'"' -f2)"

awake() {  # the address of this version of Haven if it's already awake (an older one is asked to rest)
  local port said i
  for port in 8765 8766 8767 8768 8769 8770 8771 8772 8773 8774; do
    said="$(curl -s --noproxy '*' --max-time 2 "http://127.0.0.1:$port/api/chat" 2>/dev/null)"
    case "$said" in *'"stage"'*) ;; *) continue ;; esac
    if printf '%s' "$said" | grep -q "\"version\": \"$VERSION\""; then
      echo "http://127.0.0.1:$port/"
      return 0
    fi
    curl -s --noproxy '*' --max-time 5 -X POST -H "Content-Type: application/json" -d '{}' \
      "http://127.0.0.1:$port/api/rest" > /dev/null 2>&1
    for i in $(seq 1 40); do  # wait for the older Haven to save and rest
      curl -s --noproxy '*' --max-time 1 "http://127.0.0.1:$port/api/chat" > /dev/null 2>&1 || break
      sleep 0.5
    done
  done
  return 1
}

wake() {  # wake Haven: its life goes on in the background, on its own, until you press Rest in its window
  nohup "$APP/venv/bin/python" -c '
import os, sys
try:
    os.setsid()  # a session of its own, so that it goes on after this script ends
except OSError:
    pass
os.execv(sys.executable, [sys.executable, "-m", "haven", "app", "--no-browser", *sys.argv[1:]])
' ${ARGS[@]+"${ARGS[@]}"} >> "$APP/haven.log" 2>&1 < /dev/null &
  HAVEN=$!
}

waiting() {  # wait for Haven to wake up; prints its address
  local i url
  for i in $(seq 1 180); do
    url="$(awake)" && { echo "$url"; return 0; }
    kill -0 "$HAVEN" 2>/dev/null || return 1
    [ -n "$1" ] && page "$1"
    sleep 1
  done
  return 1
}

mkdir -p "$APP"
if url="$(awake)"; then  # already awake: just open its window
  open "$url"
  exit 0
fi

build="$(cat "$SOURCE/../build-id" 2>/dev/null)"
if [ -x "$APP/venv/bin/python" ] && [ -n "$build" ] && [ "$(cat "$APP/installed" 2>/dev/null)" = "$build" ]; then
  wake
  if url="$(waiting)"; then
    open "$url"
    exit 0
  fi
  tail -n 30 "$APP/haven.log" > "$LOG"
  page 4 failed "Haven didn't wake up; what it said is below."
  open "$PAGE"
  exit 1
fi

# The first time (or the first time since Haven was updated): set it up, with the progress in the browser.
if ! mkdir "$APP/setting-up" 2>/dev/null; then
  if kill -0 "$(cat "$APP/setting-up/pid" 2>/dev/null)" 2>/dev/null; then
    open "$PAGE"  # it's already setting up
    exit 0
  fi
  rm -rf "$APP/setting-up"
  mkdir "$APP/setting-up"
fi
echo $$ > "$APP/setting-up/pid"
trap 'rm -rf "$APP/setting-up"' EXIT
: > "$LOG"
page 1
open "$PAGE"

UV="$(command -v uv)"
if [ -z "$UV" ]; then
  step 1 sh -c 'curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$1" UV_NO_MODIFY_PATH=1 sh' sh "$APP/bin" \
    || fail 1 "Couldn't get the installer (uv)."
  UV="$APP/bin/uv"
fi
if [ ! -x "$APP/venv/bin/python" ]; then
  step 2 "$UV" venv --python 3.12 "$APP/venv" || fail 2 "Couldn't get Python."
fi
rm -rf "$APP/src" && cp -R "$SOURCE" "$APP/src" || fail 3 "Couldn't copy Haven's code."
install_parts() {  # --torch-backend=auto picks the PyTorch build that suits this Mac
  cd "$APP/src" || return 1
  "$UV" pip install --python "$APP/venv/bin/python" --torch-backend=auto ".[cortex]" \
    || "$UV" pip install --python "$APP/venv/bin/python" ".[cortex]"
}
step 3 install_parts || fail 3 "Couldn't install what Haven runs on."
echo "$build" > "$APP/installed"

page 4
wake
if url="$(waiting 4)"; then
  page 4 done "$url"
  exit 0
fi
tail -n 30 "$APP/haven.log" >> "$LOG"
fail 4 "Haven didn't wake up; what it said is below."
